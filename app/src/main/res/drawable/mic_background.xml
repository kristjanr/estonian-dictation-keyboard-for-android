<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected means "listening"; the service drives it from engine state. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mic_listening" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_background_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mic_idle" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
